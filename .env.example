APP_NAME=Ballet
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
CSP_REPORT_ONLY=false

# Comma separated proxy IPs/CIDRs in front of the app (Nginx, Cloudflare, LB). Empty = none.
TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL runs in Docker (see docker-compose.yml). Local dev values only.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ballet
DB_USERNAME=ballet
DB_PASSWORD=change-me-local
DB_ROOT_PASSWORD=change-me-root

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# true in production (HTTPS only). false for local http://
SESSION_SECURE_COOKIE=false

# Local: Mailpit from docker-compose, inbox at http://localhost:8025
# Production: put the real SMTP host and credentials here (never commit them).
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@ballet.local"
MAIL_FROM_NAME="${APP_NAME}"
